# Bazel
## Ignore all bazel-* symlinks. There is no full list since this can change
## based on the name of the directory bazel is cloned into.
/bazel-*
MODULE.bazel
MODULE.bazel.lock

*.pyc
*.so
*.egg-info
*.whl
*_pb2.py

.ipynb_checkpoints
.DS_Store
.mypy_cache/
.pytype/

.idea
.vscode
.envrc
.bazelrc.user

# virtualenv/venv directories
/venv/
/bin/
/include/
/lib/
/share/


# XProf UI test suite / local frontend build
frontend/dist/
tests/ui/goldens/diffs/
.venv-uitest/
# Cache artifacts the server writes into whatever --logdir it is pointed at
demo/plugins/profile/*/.cached_tools.json
demo/plugins/profile/*/cache_version.txt
demo/plugins/profile/*/ALL_HOSTS.op_stats_v2.pb
demo/plugins/profile/*/*.hlo_proto.pb
demo/plugins/profile/*/*.SSTABLE
node_modules/
frontend/.angular/
